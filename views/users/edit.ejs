<%- include('../partials/header', {title: 'Rediger bruker'}) %>
<%- include('../partials/navbar') %>

<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h4>Rediger bruker</h4>
        </div>
        <div class="card-body">
          <% if (typeof error !== 'undefined') { %>
            <div class="alert alert-danger" role="alert">
              <%= error %>
            </div>
          <% } %>
          <form action="/api/users/update/<%= editUser._id %>" method="POST">
            <div class="mb-3">
              <label for="name" class="form-label">Navn</label>
              <input type="text" class="form-control" id="name" name="name" value="<%= editUser.name %>" required>
            </div>
            <div class="mb-3">
              <label for="email" class="form-label">E-post</label>
              <input type="email" class="form-control" id="email" name="email" value="<%= editUser.email %>" required>
              <small class="form-text text-muted">Merk: endring av e-post kan påvirke brukerens innlogging.</small>
            </div>
            <div class="mb-3">
              <label for="role" class="form-label">Rolle</label>
              <select class="form-select" id="role" name="role" required>
                <option value="user" <%= editUser.role === 'user' ? 'selected' : '' %>>Standard bruker</option>
                <option value="1. linje" <%= editUser.role === '1. linje' ? 'selected' : '' %>>1. linje</option>
                <option value="2. linje" <%= editUser.role === '2. linje' ? 'selected' : '' %>>2. linje</option>
                <option value="admin" <%= editUser.role === 'admin' ? 'selected' : '' %>>Administrator</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Registrert</label>
              <input type="text" class="form-control" value="<%= new Date(editUser.createdAt).toLocaleString('no-NO') %>" readonly>
            </div>
            <div class="d-flex justify-content-between">
              <button type="submit" class="btn btn-primary">Lagre endringer</button>
              <a href="/api/users/admin" class="btn btn-secondary">Tilbake til brukeradministrasjon</a>
            </div>
          </form>
          
          <% if (user._id.toString() !== editUser._id.toString()) { %>
            <hr class="mt-4 mb-4">
            <h5 class="text-danger">Danger Zone</h5>
            <p>Sletting av bruker vil beholde alle henvendelser, men knytte dem til en "Slettet bruker"-konto.</p>
            <form id="deleteForm" action="/api/users/delete/<%= editUser._id %>" method="POST" onsubmit="return confirmDelete()">
              <button type="submit" class="btn btn-danger">Slett bruker</button>
            </form>
            
            <script>
              function confirmDelete() {
                return confirm('Er du sikker på at du vil slette denne brukeren? Denne handlingen kan ikke angres. Alle brukerens henvendelser vil bli beholdt, men knyttet til en anonym bruker.');
              }
            </script>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
