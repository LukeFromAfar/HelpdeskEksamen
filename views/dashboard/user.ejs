<%- include('../partials/header', {title: 'Mitt dashbord'}) %>
<%- include('../partials/navbar') %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Mitt dashbord</h1>
    <a href="/api/tickets/create" class="btn btn-primary">Opprett ny henvendelse</a>
  </div>
  
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Velkommen, <%= user.name %></h5>
      <p class="card-text">Her kan du se alle dine henvendelser og deres status.</p>
    </div>
  </div>
  
  <% if (activeTickets.length === 0 && closedTickets.length === 0) { %>
    <div class="alert alert-info" role="alert">
      Du har ingen henvendelser enda. Opprett din første henvendelse nå!
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>ID</th>
            <th>Tittel</th>
            <th>Kategori</th>
            <th>Status</th>
            <th>Prioritet</th>
            <th>Opprettet</th>
          </tr>
        </thead>
        <tbody id="userTicketList">
          <% if (activeTickets.length > 0) { %>
            <% activeTickets.forEach(ticket => { %>
              <tr class="ticket-row" data-id="<%= ticket._id %>">
                <td><%= ticket._id %></td>
                <td class="ticket-title" title="<%= ticket.title %>"><%= ticket.title %></td>
                <td><%= ticket.category %></td>
                <td>
                  <span class="badge bg-<%= 
                    ticket.status === 'Åpen' ? 'danger' : 
                    ticket.status === 'Under arbeid' ? 'warning' : 
                    ticket.status === 'Løst' ? 'success' : 'secondary' 
                  %>"><%= ticket.status %></span>
                </td>
                <td>
                  <span class="badge bg-<%= 
                    ticket.priority === 'Høy' ? 'danger' : 
                    ticket.priority === 'Medium' ? 'warning' : 'info' 
                  %>"><%= ticket.priority %></span>
                </td>
                <td><%= new Date(ticket.createdAt).toLocaleString('no-NO') %></td>
              </tr>
            <% }) %>
          <% } %>
          
          <% if (closedTickets.length > 0) { %>
            <!-- Divider row -->
            <tr class="ticket-divider">
              <td colspan="6" class="text-center bg-light">
                <strong>Lukkede henvendelser</strong>
              </td>
            </tr>
            
            <% closedTickets.forEach(ticket => { %>
              <tr class="ticket-row closed-ticket" data-id="<%= ticket._id %>">
                <td><%= ticket._id %></td>
                <td class="ticket-title" title="<%= ticket.title %>"><%= ticket.title %></td>
                <td><%= ticket.category %></td>
                <td>
                  <span class="badge bg-secondary"><%= ticket.status %></span>
                </td>
                <td>
                  <span class="badge bg-<%= 
                    ticket.priority === 'Høy' ? 'danger' : 
                    ticket.priority === 'Medium' ? 'warning' : 'info' 
                  %>"><%= ticket.priority %></span>
                </td>
                <td><%= new Date(ticket.createdAt).toLocaleString('no-NO') %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
