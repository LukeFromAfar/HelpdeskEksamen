<%- include('../partials/header', {title: 'Admin dashbord'}) %>
<%- include('../partials/navbar') %>

<div class="container-fluid mt-4">
  <h1 class="mb-4">Admin dashbord</h1>
  
  <!-- Hidden data div for charts -->
  <div id="chartStatsData" class="d-none"><%= JSON.stringify(stats) %></div>
  
  <!-- Stats charts -->
  <div class="row mb-4">
    <div class="col-md-6 mb-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <h5 class="card-title">Status fordeling</h5>
            <div>
              <span class="badge bg-danger me-1">Åpne: <%= stats.openCount %></span>
              <span class="badge bg-warning me-1">Under arbeid: <%= stats.inProgressCount %></span>
              <span class="badge bg-success">Løst: <%= stats.solvedCount %></span>
              <span class="badge bg-secondary ms-2">Lukket: <%= stats.closed %> (ikke i diagram)</span>
            </div>
          </div>
          <div class="chart-container" style="position: relative; height: 250px;">
            <canvas id="statusChart"></canvas>
          </div>
          <div class="text-center mt-2">
            <strong>Aktive: <%= stats.total %> henvendelser</strong>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-6 mb-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <h5 class="card-title">Prioritet fordeling</h5>
            <div>
              <span class="badge bg-danger me-1">Høy: <%= stats.highPriorityCount %></span>
              <span class="badge bg-warning me-1">Medium: <%= stats.mediumPriorityCount %></span>
              <span class="badge bg-info">Lav: <%= stats.lowPriorityCount %></span>
            </div>
          </div>
          <div class="chart-container" style="position: relative; height: 250px;">
            <canvas id="priorityChart"></canvas>
          </div>
          <div class="text-center mt-2">
            <strong>Totalt: <%= stats.total %> henvendelser</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Ticket filter -->
  <div class="card mb-4">
    <div class="card-header">
      <h5>Filtrer henvendelser</h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <div class="input-group">
            <input type="text" id="ticketSearch" class="form-control" placeholder="Søk på tittel, brukernavn eller ID...">
            <button class="btn btn-outline-secondary" type="button" id="clearSearch">
              <i class="bi bi-x"></i> Tøm
            </button>
          </div>
          <small class="form-text text-muted">Søk på tittel, brukernavn eller ID</small>
        </div>
        <div class="col-md-8">
          <div class="row g-2">
            <div class="col-md-4">
              <select class="form-select" id="statusFilter">
                <option value="">Alle aktive statuser</option>
                <option value="Åpen">Åpen</option>
                <option value="Under arbeid">Under arbeid</option>
                <option value="Løst">Løst</option>
                <option value="Lukket">Lukket</option>
                <option value="all">Vis alle (inkl. lukket)</option>
              </select>
            </div>
            <div class="col-md-4">
              <select class="form-select" id="categoryFilter">
                <option value="">Alle kategorier</option>
                <option value="Hardware">Hardware</option>
                <option value="Software">Software</option>
                <option value="Nettverk">Nettverk</option>
                <option value="Konto">Konto/Tilgang</option>
                <option value="Annet">Annet</option>
              </select>
            </div>
            <div class="col-md-4">
              <select class="form-select" id="priorityFilter">
                <option value="">Alle prioriteter</option>
                <option value="Høy">Høy</option>
                <option value="Medium">Medium</option>
                <option value="Lav">Lav</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Ticket table -->
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Alle henvendelser</h5>
      <span id="ticketCount" class="badge bg-secondary"></span>
    </div>
    <div class="card-body">
      <% if (tickets.length === 0) { %>
        <div class="alert alert-info" role="alert">
          Det er ingen henvendelser i systemet.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>ID</th>
                <th>Tittel</th>
                <th>Bruker</th>
                <th>Kategori</th>
                <th>Status</th>
                <th>Prioritet</th>
                <th>Opprettet</th>
                <th>Sist oppdatert</th>
                <th>Handlinger</th>
              </tr>
            </thead>
            <tbody id="adminTicketList">
              <% tickets.forEach(ticket => { %>
                <tr class="ticket-row" data-id="<%= ticket._id %>" 
                    data-status="<%= ticket.status %>" 
                    <%= ticket.status === 'Lukket' ? 'data-closed="true"' : '' %>>
                  <td><%= ticket._id %></td>
                  <td class="ticket-title" title="<%= ticket.title %>"><%= ticket.title %></td>
                  <td><%= ticket.user ? ticket.user.name : 'Ukjent' %></td>
                  <td><%= ticket.category %></td>
                  <td>
                    <span class="badge bg-<%= 
                      ticket.status === 'Åpen' ? 'danger' : 
                      ticket.status === 'Under arbeid' ? 'warning' : 
                      ticket.status === 'Løst' ? 'success' : 'secondary' 
                    %>"><%= ticket.status %></span>
                  </td>
                  <td>
                    <span class="badge bg-<%= 
                      ticket.priority === 'Høy' ? 'danger' : 
                      ticket.priority === 'Medium' ? 'warning' : 'info' 
                    %>"><%= ticket.priority %></span>
                  </td>
                  <td><%= new Date(ticket.createdAt).toLocaleString('no-NO') %></td>
                  <td><%= new Date(ticket.updatedAt).toLocaleString('no-NO') %></td>
                  <td>
                    <a href="/api/tickets/view/<%= ticket._id %>" class="btn btn-sm btn-info">Vis</a>
                    <a href="/api/tickets/edit/<%= ticket._id %>" class="btn btn-sm btn-warning">Rediger</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
