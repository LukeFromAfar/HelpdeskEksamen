<%- include('../partials/header', {title: 'Admin dashbord'}) %>
<%- include('../partials/navbar') %>

<div class="container-fluid mt-4">
  <h1 class="mb-4">Admin dashbord</h1>
  
  <!-- Hidden data div for charts -->
  <div id="chartStatsData" class="d-none"><%= JSON.stringify(stats) %></div>
  
  <!-- Stats charts -->
  <div class="row mb-4">
    <div class="col-md-6 mb-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <h5 class="card-title">Status fordeling</h5>
            <div>
              <span class="badge bg-danger me-1">Åpne: <%= stats.openCount %></span>
              <span class="badge bg-warning me-1">Under arbeid: <%= stats.inProgressCount %></span>
              <span class="badge bg-success">Løst: <%= stats.solvedCount %></span>
              <span class="badge bg-secondary ms-2">Lukket: <%= stats.closed %> (ikke i diagram)</span>
            </div>
          </div>
          <div class="chart-container" style="position: relative; height: 250px;">
            <canvas id="statusChart"></canvas>
          </div>
          <div class="text-center mt-2">
            <strong>Aktive: <%= stats.total %> henvendelser</strong>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-6 mb-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <h5 class="card-title">Prioritet fordeling</h5>
            <div>
              <span class="badge bg-danger me-1">Høy: <%= stats.highPriorityCount %></span>
              <span class="badge bg-warning me-1">Medium: <%= stats.mediumPriorityCount %></span>
              <span class="badge bg-info">Lav: <%= stats.lowPriorityCount %></span>
            </div>
          </div>
          <div class="chart-container" style="position: relative; height: 250px;">
            <canvas id="priorityChart"></canvas>
          </div>
          <div class="text-center mt-2">
            <strong>Totalt: <%= stats.total %> henvendelser</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Ticket filter -->
  <div class="card mb-4">
    <div class="card-header">
      <h5>Filtrer henvendelser</h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <div class="input-group">
            <input type="text" id="ticketSearch" class="form-control" placeholder="Søk på tittel, brukernavn eller ID...">
            <button class="btn btn-outline-secondary" type="button" id="clearSearch">
              <i class="bi bi-x"></i> Tøm
            </button>
          </div>
          <small class="form-text text-muted">Søk på tittel, brukernavn eller ID</small>
        </div>
        <div class="col-md-8">
          <div class="row g-2">
            <div class="col-md-3">
              <select class="form-select" id="statusFilter">
                <option value="">Alle aktive statuser</option>
                <option value="Åpen" <%= statusFilter === 'Åpen' ? 'selected' : '' %>>Åpen</option>
                <option value="Under arbeid" <%= statusFilter === 'Under arbeid' ? 'selected' : '' %>>Under arbeid</option>
                <option value="Løst" <%= statusFilter === 'Løst' ? 'selected' : '' %>>Løst</option>
                <option value="Lukket" <%= statusFilter === 'Lukket' ? 'selected' : '' %> class="text-muted">Lukket</option>
                <option value="all" <%= statusFilter === 'all' || !statusFilter ? 'selected' : '' %>>Vis alle (inkl lukket)</option>
              </select>
            </div>
            <div class="col-md-3">
              <select class="form-select" id="categoryFilter">
                <option value="" <%= !categoryFilter ? 'selected' : '' %>>Alle kategorier</option>
                <option value="Hardware" <%= categoryFilter === 'Hardware' ? 'selected' : '' %>>Hardware</option>
                <option value="Software" <%= categoryFilter === 'Software' ? 'selected' : '' %>>Software</option>
                <option value="Nettverk" <%= categoryFilter === 'Nettverk' ? 'selected' : '' %>>Nettverk</option>
                <option value="Konto" <%= categoryFilter === 'Konto' ? 'selected' : '' %>>Konto/Tilgang</option>
                <option value="Annet" <%= categoryFilter === 'Annet' ? 'selected' : '' %>>Annet</option>
              </select>
            </div>
            <div class="col-md-3">
              <select class="form-select" id="priorityFilter">
                <option value="" <%= !priorityFilter ? 'selected' : '' %>>Alle prioriteter</option>
                <option value="Høy" <%= priorityFilter === 'Høy' ? 'selected' : '' %>>Høy</option>
                <option value="Medium" <%= priorityFilter === 'Medium' ? 'selected' : '' %>>Medium</option>
                <option value="Lav" <%= priorityFilter === 'Lav' ? 'selected' : '' %>>Lav</option>
              </select>
            </div>
            <div class="col-md-3">
              <select class="form-select" id="sortSelector">
                <option value="createdAt:desc" <%= sortField === 'createdAt' && sortOrder === 'desc' ? 'selected' : '' %>>Nyeste først</option>
                <option value="createdAt:asc" <%= sortField === 'createdAt' && sortOrder === 'asc' ? 'selected' : '' %>>Eldste først</option>
                <option value="title:asc" <%= sortField === 'title' && sortOrder === 'asc' ? 'selected' : '' %>>Tittel A-Å</option>
                <option value="title:desc" <%= sortField === 'title' && sortOrder === 'desc' ? 'selected' : '' %>>Tittel Å-A</option>
                <option value="user.name:asc" <%= sortField === 'user.name' && sortOrder === 'asc' ? 'selected' : '' %>>Bruker A-Å</option>
                <option value="user.name:desc" <%= sortField === 'user.name' && sortOrder === 'desc' ? 'selected' : '' %>>Bruker Å-A</option>
                <option value="category:asc" <%= sortField === 'category' && sortOrder === 'asc' ? 'selected' : '' %>>Kategori A-Å</option>
                <option value="category:desc" <%= sortField === 'category' && sortOrder === 'desc' ? 'selected' : '' %>>Kategori Å-A</option>
                <option value="priority:asc" <%= sortField === 'priority' && sortOrder === 'asc' ? 'selected' : '' %>>Prioritet (Lav → Medium → Høy)</option>
                <option value="priority:desc" <%= sortField === 'priority' && sortOrder === 'desc' ? 'selected' : '' %>>Prioritet (Høy → Medium → Lav)</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Ticket table -->
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Alle henvendelser</h5>
      <span id="ticketCount" class="badge bg-secondary"></span>
    </div>
    <div class="card-body">
      <% if (tickets.length === 0) { %>
        <div class="alert alert-info" role="alert">
          Det er ingen henvendelser i systemet.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>ID</th>
                <th>Tittel</th>
                <th>Bruker</th>
                <th>Kategori</th>
                <th>Status</th>
                <th>Prioritet</th>
                <th>Opprettet</th>
                <th>Sist oppdatert</th>
                <th>Handlinger</th>
              </tr>
            </thead>
            <tbody id="adminTicketList">
              <% tickets.forEach(ticket => { %>
                <tr class="ticket-row" data-id="<%= ticket._id %>" 
                    data-status="<%= ticket.status %>" 
                    <%= ticket.status === 'Lukket' ? 'data-closed="true"' : '' %>>
                  <td><%= ticket._id %></td>
                  <td class="ticket-title" title="<%= ticket.title %>"><%= ticket.title %></td>
                  <td><%= ticket.user ? ticket.user.name : 'Ukjent' %></td>
                  <td><%= ticket.category %></td>
                  <td>
                    <span class="badge bg-<%= 
                      ticket.status === 'Åpen' ? 'danger' : 
                      ticket.status === 'Under arbeid' ? 'warning' : 
                      ticket.status === 'Løst' ? 'success' : 'secondary' 
                    %>"><%= ticket.status %></span>
                  </td>
                  <td>
                    <span class="badge bg-<%= 
                      ticket.priority === 'Høy' ? 'danger' : 
                      ticket.priority === 'Medium' ? 'warning' : 'info' 
                    %>"><%= ticket.priority %></span>
                  </td>
                  <td><%= new Date(ticket.createdAt).toLocaleString('no-NO') %></td>
                  <td><%= new Date(ticket.updatedAt).toLocaleString('no-NO') %></td>
                  <td>
                    <a href="/api/tickets/edit/<%= ticket._id %>" class="btn btn-sm btn-warning">Rediger</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-4">
          <div>
            Viser <%= tickets.length %> av <%= totalTickets %> henvendelser
          </div>
          <nav aria-label="Sidenavigasjon">
            <ul class="pagination mb-0">
              <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/api/tickets/admin?page=1&sortField=<%= sortField %>&sortOrder=<%= sortOrder %><%= statusFilter ? '&status=' + statusFilter : '' %><%= priorityFilter ? '&priority=' + priorityFilter : '' %><%= categoryFilter ? '&category=' + categoryFilter : '' %>">Første</a>
              </li>
              <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/api/tickets/admin?page=<%= currentPage - 1 %>&sortField=<%= sortField %>&sortOrder=<%= sortOrder %><%= statusFilter ? '&status=' + statusFilter : '' %><%= priorityFilter ? '&priority=' + priorityFilter : '' %><%= categoryFilter ? '&category=' + categoryFilter : '' %>">Forrige</a>
              </li>
              
              <% for(let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                  <a class="page-link" href="/api/tickets/admin?page=<%= i %>&sortField=<%= sortField %>&sortOrder=<%= sortOrder %><%= statusFilter ? '&status=' + statusFilter : '' %><%= priorityFilter ? '&priority=' + priorityFilter : '' %><%= categoryFilter ? '&category=' + categoryFilter : '' %>"><%= i %></a>
                </li>
              <% } %>
              
              <li class="page-item <%= currentPage === totalPages || totalPages === 0 ? 'disabled' : '' %>">
                <a class="page-link" href="/api/tickets/admin?page=<%= currentPage + 1 %>&sortField=<%= sortField %>&sortOrder=<%= sortOrder %><%= statusFilter ? '&status=' + statusFilter : '' %><%= priorityFilter ? '&priority=' + priorityFilter : '' %><%= categoryFilter ? '&category=' + categoryFilter : '' %>">Neste</a>
              </li>
              <li class="page-item <%= currentPage === totalPages || totalPages === 0 ? 'disabled' : '' %>">
                <a class="page-link" href="/api/tickets/admin?page=<%= totalPages %>&sortField=<%= sortField %>&sortOrder=<%= sortOrder %><%= statusFilter ? '&status=' + statusFilter : '' %><%= priorityFilter ? '&priority=' + priorityFilter : '' %><%= categoryFilter ? '&category=' + categoryFilter : '' %>">Siste</a>
              </li>
            </ul>
          </nav>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
