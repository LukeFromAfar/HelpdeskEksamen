<%- include('../partials/header', {title: 'Vis henvendelse'}) %>
<%- include('../partials/navbar') %>

<div class="container mt-4">
  <div class="row">
    <div class="col-md-8">
      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h4>Henvendelse: <%= ticket.title %></h4>
          <span class="badge bg-<%= 
            ticket.status === 'Åpen' ? 'danger' : 
            ticket.status === 'Under arbeid' ? 'warning' : 
            ticket.status === 'Løst' ? 'success' : 'secondary' 
          %>"><%= ticket.status %></span>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <strong>ID:</strong> <%= ticket._id %>
          </div>
          <div class="mb-3">
            <strong>Kategori:</strong> <%= ticket.category %>
          </div>
          <div class="mb-3">
            <strong>Prioritet:</strong> 
            <span class="badge bg-<%= 
              ticket.priority === 'Høy' ? 'danger' : 
              ticket.priority === 'Medium' ? 'warning' : 'info' 
            %>"><%= ticket.priority %></span>
          </div>
          <div class="mb-3">
            <strong>Tildelt til:</strong> 
            <% if (ticket.assignedTo) { %>
              <span class="badge bg-<%= 
                ticket.assignedTo === '1. linje' ? 'primary' : 
                ticket.assignedTo === '2. linje' ? 'info' : 'dark' 
              %>"><%= ticket.assignedTo %></span>
            <% } else { %>
              <span class="badge bg-secondary">Ikke tildelt</span>
            <% } %>
          </div>
          <div class="mb-3">
            <strong>Opprettet av:</strong> 
            <% if (ticket.user && ticket.user.name) { %>
              <%= ticket.user.name %>
            <% } else { %>
              <span class="text-muted">[Slettet bruker]</span>
            <% } %>
          </div>
          <div class="mb-3">
            <strong>Opprettet:</strong> <%= new Date(ticket.createdAt).toLocaleString('no-NO') %>
          </div>
          <div class="mb-3">
            <strong>Sist oppdatert:</strong> <%= new Date(ticket.updatedAt).toLocaleString('no-NO') %>
          </div>
          <div class="mb-3">
            <strong>Beskrivelse:</strong>
            <p class="mt-2"><%= ticket.description %></p>
          </div>

          <% if (ticket.status === 'Løst') { %>
            <div class="mb-3">
              <strong>Tilbakemelding status:</strong> 
              <% if (ticket.hasFeedback) { %>
                <span class="badge bg-success">Tilbakemelding mottatt</span>
              <% } else { %>
                <span class="badge bg-warning">Venter på tilbakemelding</span>
              <% } %>
            </div>
          <% } %>
          
          <% if (ticket.status === 'Løst' && ticket.user && user && 
                 ticket.user._id && ticket.user._id.toString() === user._id.toString() && 
                 !ticket.hasFeedback) { %>
            <!-- Feedback form for solved tickets -->
            <div class="card mt-4">
              <div class="card-header">
                <h5>Gi tilbakemelding</h5>
              </div>
              <div class="card-body">
                <form action="/api/tickets/feedback/<%= ticket._id %>" method="POST">
                  <div class="mb-3">
                    <label class="form-label">Hvor fornøyd er du med løsningen?</label>
                    <div class="rating-stars mb-2">
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rating" id="rating1" value="1" required>
                        <label class="form-check-label" for="rating1">1 ★</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rating" id="rating2" value="2">
                        <label class="form-check-label" for="rating2">2 ★</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rating" id="rating3" value="3">
                        <label class="form-check-label" for="rating3">3 ★</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rating" id="rating4" value="4">
                        <label class="form-check-label" for="rating4">4 ★</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rating" id="rating5" value="5">
                        <label class="form-check-label" for="rating5">5 ★</label>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3">
                    <label for="feedbackComment" class="form-label">Kommentar (valgfritt)</label>
                    <textarea class="form-control" id="feedbackComment" name="comment" rows="2"></textarea>
                  </div>
                  <button type="submit" class="btn btn-primary">Send tilbakemelding</button>
                </form>
              </div>
            </div>
          <% } else if (ticket.hasFeedback && ticket.feedback && ticket.feedback.rating) { %>
            <!-- Show existing feedback -->
            <div class="card mt-4">
              <div class="card-header">
                <h5>Tilbakemelding</h5>
              </div>
              <div class="card-body">
                <p>
                  <strong>Vurdering:</strong> 
                  <% for (let i = 0; i < ticket.feedback.rating; i++) { %>
                    <span class="text-warning">★</span>
                  <% } %>
                  <% for (let i = ticket.feedback.rating; i < 5; i++) { %>
                    <span class="text-muted">★</span>
                  <% } %>
                  (<%= ticket.feedback.rating %>/5)
                </p>
                <% if (ticket.feedback.comment) { %>
                  <p><strong>Kommentar:</strong> <%= ticket.feedback.comment %></p>
                <% } %>
                <p class="text-muted small">Gitt <%= new Date(ticket.feedback.createdAt).toLocaleString('no-NO') %></p>
              </div>
            </div>
          <% } %>
          
          <% if ((user.role === 'admin' || user.role === '1. linje' || user.role === '2. linje')) { %>
            <div class="mt-4">
              <a href="/api/tickets/edit/<%= ticket._id %>" class="btn btn-warning">Rediger henvendelse</a>
              <a href="/api/tickets/admin" class="btn btn-secondary">Tilbake til dashbord</a>
            </div>
          <% } else { %>
            <div class="mt-4">
              <a href="/api/tickets/mydashboard" class="btn btn-secondary">Tilbake til dashbord</a>
            </div>
          <% } %>
        </div>
      </div>
      
      <!-- Comments section -->
      <div class="card mb-4">
        <div class="card-header">
          <h5>Kommentarer</h5>
        </div>
        <div class="card-body">
          <!-- Existing comments -->
          <% if (ticket.comments && ticket.comments.length > 0) { %>
            <div class="comments-container mb-4">
              <% ticket.comments.forEach(comment => { %>
                <div class="comment p-3 mb-3 border rounded">
                  <div class="d-flex justify-content-between">
                    <div>
                      <% if (comment.user && comment.user.name) { %>
                        <strong><%= comment.user.name %></strong>
                        <% if (comment.user.role === 'admin') { %>
                          <span class="badge bg-primary ms-2">Admin</span>
                        <% } %>
                      <% } else { %>
                        <strong class="text-muted">[Slettet bruker]</strong>
                      <% } %>
                    </div>
                    <small><%= new Date(comment.createdAt).toLocaleString('no-NO') %></small>
                  </div>
                  <p class="mt-2 mb-0"><%= comment.text %></p>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p>Ingen kommentarer enda.</p>
          <% } %>
          
          <!-- Add new comment -->
          <form action="/api/tickets/comment/<%= ticket._id %>" method="POST">
            <div class="mb-3">
              <label for="text" class="form-label">Legg til en kommentar</label>
              <textarea class="form-control" id="text" name="text" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Send kommentar</button>
          </form>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <!-- Ticket history -->
      <div class="card">
        <div class="card-header">
          <h5>Historikk</h5>
        </div>
        <div class="card-body">
          <% if (ticket.history && ticket.history.length > 0) { %>
            <div class="history-container">
              <ul class="list-group history-list">
                <% ticket.history.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp)).forEach(item => { %>
                  <li class="list-group-item history-item">
                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <p class="mb-0"><%= item.action %></p>
                        <% if (item.user && item.user.name) { %>
                          <small class="text-muted">
                            <%= item.user.name %>
                            <% if (item.user.role === 'admin') { %>
                              <span class="badge bg-primary">Admin</span>
                            <% } %>
                          </small>
                        <% } else { %>
                          <small class="text-muted">[Slettet bruker]</small>
                        <% } %>
                      </div>
                      <small><%= new Date(item.timestamp).toLocaleString('no-NO') %></small>
                    </div>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% } else { %>
            <p>Ingen historikk tilgjengelig.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
