              Spørsmål går her
            </button>
          </h2>
          <div id="faqCollapseX" class="accordion-collapse collapse" aria-labelledby="faqHeadingX" data-bs-parent="#faqAccordion">
            <div class="accordion-body">
              <p>Svar går her</p>
            </div>
          </div>
        </div>
        -->
        
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
